# ---- Server ----
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- MongoDB ----
# Get this from MongoDB Atlas: Database > Connect > Drivers
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codesmell-sentinel

# ---- JWT (Day 2) ----
JWT_SECRET=replace_with_a_long_random_string

# ---- GitHub OAuth App (Day 2) ----
# From https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ---- GitHub Webhook (Day 4) ----
# Any random string you choose - GitHub uses it to sign webhook payloads
GITHUB_WEBHOOK_SECRET=

# ---- Gemini API (Day 8) ----
GEMINI_API_KEY=
